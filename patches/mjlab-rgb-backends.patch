@@ -0,0 +1,20 @@
+"""Minimal interface for optional RGB renderer plugins.
+
+Register a factory under the ``mjlab.rgb_renderers`` entry-point group.
+SensorContext calls it with (mj_model, model, data, sensors, wp_device).
+It returns renderers, each owning RGB tensors for its MuJoCo camera IDs.
+"""
+
+from typing import Protocol
+
+import torch
+
+
+class RgbRenderer(Protocol):
+  rgb: dict[int, torch.Tensor]
+
+  def render(self) -> None: ...
+
+  def wait_for_rgb(self) -> None: ...
+
+  def close(self) -> None: ...
